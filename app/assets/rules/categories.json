  "special": {
    "uncategorized": {
      "id": "uncategorized",
      "name": "Uncategorized",
      "kind": "expense",
      "icon": "help_outline",
      "color": "#BDBDBD",
      "_comment": "Not a real category - a queue. Every transaction that lands here is a question waiting for one tap, and that tap becomes a permanent user rule. Shown as a badge on the home screen, never silently buried."
    }
  },
  "notes": {
    "subscriptions": "Deliberately NOT a category. A Netflix charge is Entertainment and a gym charge is Health; both are also recurring. Recurrence is a FLAG on the transaction/series, not a bucket - otherwise every recurring spend gets pulled out of the category the user actually wants to budget against.",
    "cash": "An ATM withdrawal is a transfer into a virtual Cash account, not an expense. What the cash is then spent on is invisible to SMS - the app infers a cash gap and lets the user attribute it manually."
  }
